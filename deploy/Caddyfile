{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}
	# Vite fingerprints the bundles; textures and recordings keep their names, so they get a week
	@hashed path_regexp hashed ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@tex path /assets/tex/* /assets/audio/*.mp3
	header @tex Cache-Control "public, max-age=604800"
	@html path / /index.html
	header @html Cache-Control "no-cache"
	respond /healthz "sakura-ok" 200
	file_server
}
